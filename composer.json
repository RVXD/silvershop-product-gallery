{
    "name": "silvershop/product-gallery",
    "description": "Sortable image galleries for SilverShop products and variations. Backend only — the data model, CMS admin and template accessors; bring your own frontend.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "product", "variation", "images", "gallery"],
    "authors": [
        {
            "name": "Remy van Aartjes",
            "email": "remy@xd.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silvershop/core": "^6",
        "symbiote/silverstripe-gridfieldextensions": "^5",
        "colymba/gridfield-bulk-editing-tools": "^5.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\ProductGallery\\": "src/",
            "SilverShop\\ProductGallery\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
